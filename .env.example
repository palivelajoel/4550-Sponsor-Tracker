# Example .env for local development. Copy to .env and fill values.
# For Vite, client-exposed variables must begin with VITE_. Only expose public values to the browser.

VITE_TEAM_PASSWORD=Bruin@4550
VITE_ADMIN_PASSWORD=Admin@4550

# Server-side keys (do NOT prefix with VITE_). These belong in your deployment environment only.
# Data lives in Cloudflare D1, bridged through a single thin gateway Worker.
# D1_GATEWAY_URL = https://d1-gateway.palivelajoel.workers.dev
# D1_GATEWAY_TOKEN = the same value as the Worker's API_TOKEN secret
D1_GATEWAY_URL=https://d1-gateway.palivelajoel.workers.dev
D1_GATEWAY_TOKEN=generate-a-random-secret-string-matching-the-worker-API_TOKEN
# GROQ_API_KEY=your_groq_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GITHUB_TOKEN=github-pat-for-media-uploads
# JWT_SECRET=generate-a-random-secret-string-for-signing-tokens
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_BOT_TOKEN=generate-a-random-secret-string-for-pipedream-auth
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...
# GOOGLE_PRIVATE_KEY=...
# GOOGLE_SHEET_ID=...
