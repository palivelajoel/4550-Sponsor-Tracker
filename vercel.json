{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest" },
    { "source": "/api/admin-login", "destination": "/api/auth" },
    { "source": "/api/admin-logout", "destination": "/api/auth" },
    { "source": "/api/hub-login", "destination": "/api/auth" },
    { "source": "/api/admin-proxy", "destination": "/api/proxy" },
    { "source": "/api/hub-proxy", "destination": "/api/proxy" },
    { "source": "/api/sheets-sync", "destination": "/api/sheets" },
    { "source": "/api/identify-item", "destination": "/api/ai" },
    { "source": "/api/extract-brands", "destination": "/api/ai" },
    { "source": "/api/upload", "destination": "/api/upload" },
    { "source": "/api/d1", "destination": "/api/d1" },
    { "source": "/api/d1/:path*", "destination": "/api/d1" },
    { "source": "/api/lookup", "destination": "/api/ai" },
    { "source": "/api/parse-csv", "destination": "/api/ai" },
    { "source": "/api/calendar.ics", "destination": "/api/calendar.ics" },
    { "source": "/api/announce-to-discord", "destination": "/api/discord/announce-to-discord" },
    { "source": "/api/discord-to-announcement", "destination": "/api/discord/discord-to-announcement" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/mirror/:path*", "destination": "/mirror/:path*" },
    { "source": "/((?!sw\\.js$|registerSW\\.js$|workbox-.*\\.js$|llms\\.txt$|sitemap\\.xml$|mirror/.*|googleea9a57ee0e3bd984\\.html).*)", "destination": "/index.html" }
  ]
}
