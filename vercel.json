{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/manifest" },
    { "source": "/api/admin-login", "destination": "/api/auth" },
    { "source": "/api/admin-logout", "destination": "/api/auth" },
    { "source": "/api/hub-login", "destination": "/api/auth" },
    { "source": "/api/admin-proxy", "destination": "/api/proxy" },
    { "source": "/api/hub-proxy", "destination": "/api/proxy" },
    { "source": "/api/identify-item", "destination": "/api/ai" },
    { "source": "/api/extract-brands", "destination": "/api/ai" },
    { "source": "/api/lookup", "destination": "/api/ai" },
    { "source": "/api/trace-pit-map", "destination": "/api/ai" },
    { "source": "/api/announce-to-discord", "destination": "/api/discord/announce-to-discord" },
    { "source": "/api/discord-to-announcement", "destination": "/api/discord/discord-to-announcement" },
    { "source": "/((?!sw\\.js$|registerSW\\.js$|workbox-.*\\.js$).*)", "destination": "/index.html" }
  ]
}
